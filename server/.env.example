# Twilio credentials for server/ ONLY. Never commit real values.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ALERT_TO=

# Supabase PostgreSQL Database credentials (Server-side ONLY - Render environment)
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Use secret / service_role key on backend to bypass RLS for writes
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Optional: backend port (default 5000)
PORT=5000
