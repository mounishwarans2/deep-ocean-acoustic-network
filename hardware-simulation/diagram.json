{
  "version": 1,
  "author": "MARISLINK Intelligent Acoustic System",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-ssd1306",
      "id": "oled",
      "top": -160,
      "left": 140,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "board-bmp180",
      "id": "bmp",
      "top": -140,
      "left": 320,
      "attrs": {
        "temperature": "24.5",
        "pressure": "101325"
      }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_battery",
      "top": 240,
      "left": -120,
      "attrs": {}
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_signal",
      "top": 240,
      "left": 40,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led_tx",
      "top": 80,
      "left": 200,
      "attrs": { "color": "green", "label": "TX_ACTIVE" }
    },
    {
      "type": "wokwi-led",
      "id": "led_sync",
      "top": 130,
      "left": 200,
      "attrs": { "color": "yellow", "label": "SYNC_LOCK" }
    },
    {
      "type": "wokwi-led",
      "id": "led_alert",
      "top": 180,
      "left": 200,
      "attrs": { "color": "red", "label": "FAULT_ALERT" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 90,
      "left": 260,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 140,
      "left": 260,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r3",
      "top": 190,
      "left": 260,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "oled:3V3", "red", [ "v-40", "h140" ] ],
    [ "oled:3V3", "bmp:VCC", "red", [ "h50" ] ],
    [ "esp:GND.1", "oled:GND", "black", [ "v-30", "h130" ] ],
    [ "oled:GND", "bmp:GND", "black", [ "h50" ] ],

    [ "esp:D21", "oled:DATA", "blue", [ "v-20" ] ],
    [ "oled:DATA", "bmp:SDA", "blue", [ "v20", "h100" ] ],
    [ "esp:D22", "oled:CLK", "yellow", [ "v-30" ] ],
    [ "oled:CLK", "bmp:SCL", "yellow", [ "v30", "h100" ] ],

    [ "esp:3V3", "pot_battery:VCC", "red", [ "h-40", "v240" ] ],
    [ "esp:GND.1", "pot_battery:GND", "black", [ "h-50", "v250" ] ],
    [ "esp:D34", "pot_battery:SIG", "orange", [ "v40" ] ],

    [ "esp:3V3", "pot_signal:VCC", "red", [ "h-40", "v240", "h160" ] ],
    [ "esp:GND.1", "pot_signal:GND", "black", [ "h-50", "v250", "h160" ] ],
    [ "esp:D35", "pot_signal:SIG", "purple", [ "v40" ] ],

    [ "esp:D2", "led_tx:A", "green", [ "h30" ] ],
    [ "led_tx:C", "r1:1", "green", [ "h10" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "h20", "v-60" ] ],

    [ "esp:D4", "led_sync:A", "yellow", [ "h30" ] ],
    [ "led_sync:C", "r2:1", "yellow", [ "h10" ] ],
    [ "r2:2", "esp:GND.2", "black", [ "h20", "v-110" ] ],

    [ "esp:D15", "led_alert:A", "red", [ "h30" ] ],
    [ "led_alert:C", "r3:1", "red", [ "h10" ] ],
    [ "r3:2", "esp:GND.2", "black", [ "h20", "v-160" ] ]
  ],
  "dependencies": {}
}
